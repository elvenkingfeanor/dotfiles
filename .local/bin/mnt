#!/bin/sh
#mnt
# mount removable drives and cd into it

# lets make it nicer by being interactive
log="$HOME/.local/share/mnt.log"

# check whether dmenu is present, if not check for fzf, else exit
if ! command -v dmenu > /dev/null 2>&1; then
	if command -v fzf > /dev/null 2>&1; then
	chooser="fzf"
	else
		notify-send "Error" "Install dmenu or fzf to proceed"
		exit 1
	fi
else
	chooser="dmenu"
fi

# get list of drives attached
drive="$(lsblk -anlp -o +LABEL | \
        grep -vE "nvme|backup" | \
        grep part | \
        cut -d ' ' -f 1)"

# if no removable drive attached, exit gracefully
if [ -z "$drive" ]; then
    notify-send "No drives attached" "Nothing to mount"
    exit 1
fi

# if only 1 removable drive attached, skip chooser application
# select removable drive to mount
if [ "$(printf "%s\n" "$drive" | \
    wc -l)" -eq 1 ]; then
    selected="$drive"
else
    if [ "$chooser" = "dmenu" ]; then
        selected="$(printf "%s" "$drive" | \
            dmenu -p "choose device to mount: ")"
    else
        selected="$(printf "%s" "$drive" | \
            fzf --prompt="choose device to mount: ")"
    fi
fi

# mount drive as per its label, else use device number (default)
lbl="$(lsblk -anlp -o +LABEL | \
    grep "$selected" | \
    sed 's@\ \ *@\ @g' | \
    cut -d ' ' -f 7)"
dnum="$(lsblk -anlp | \
    grep "$selected" | \
    cut -d ' ' -f 1)"

# check whether selected drive is already mounted, else mount it and cd into it
if [ -n "$(findmnt "$selected")" ]; then
    notify-send "$selected already mounted" "Nothing to mount"
    exit 1
else
    if [ -z "$lbl" ]; then
        if ! pmount "$selected" 2>> "$log"; then
            notify-send "$selected couldnot be mounted" "Check logfile for details"
            exit 1
        else
            notify-send "$selected successfully mounted" "at /media/$dnum"
        	pkill -RTMIN+14 -f dwmblocks
            cd /media/"$dnum" || exit 1
        fi
    else
        if ! pmount "$selected" "$lbl" 2>> "$log"; then
            notify-send "$selected couldnot be mounted" "Check logfile for details"
            exit 1
        else
            notify-send "$selected successfully mounted" "at /media/$lbl"
        	pkill -RTMIN+14 -f dwmblocks
            cd /media/"$lbl" || exit 1
        fi
    fi
fi

$SHELL
