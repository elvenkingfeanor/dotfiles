#!/bin/sh
#freedisk
# check storage space used and available on / and /home partitions

# available space on /home partition
avh="$(df -h ~ | \
    tail -n 1 | \
    tr -s '[:blank:]' | \
    cut -d ' ' -f 4)"

# percent used space on /home partition
usph="$(df -h ~ | \
    tail -n 1 | \
    tr -s '[:blank:]' | \
    cut -d ' ' -f 5)"

# available space on / partition
avr="$(df -h / | \
    tail -n 1 | \
    tr -s '[:blank:]' | \
    cut -d ' ' -f 4)"

# percent used space on / partition
uspr="$(df -h / | \
    tail -n 1 | \
    tr -s '[:blank:]' | \
    cut -d ' ' -f 5)"

# varh=$(df -h ~ | awk 'FNR == 2 {print $5,$4}') # too much awk!
# varr=$(df -h / | awk 'FNR == 2 {print $5,$4}') # well, this is AWKward!
# echo "$varh|$varr" | sed 's/\ /:/g'

printf "%s" "🗄️$usph:$avh💿$uspr:$avr"
