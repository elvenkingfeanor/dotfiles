# check if xkblayout-state is installed, else exit
if ! command -v xkblayout-state > /dev/null 2>&1; then
    printf "%s\n" "please install xkblayout-state first"
    exit 1
fi

# report keyboard settings in final output format
if [ "$(xkblayout-state print %c)" = "0" ]; then
    printf "%s" "🎹us"
elif [ "$(xkblayout-state print %c)" = "1" ]; then
    printf "%s" "🎹in"
else
    printf "%s" "🎹bd"
fi
