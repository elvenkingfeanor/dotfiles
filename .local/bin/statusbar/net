#!/bin/sh
#net
# show network received and transferred rates

# ifstat wlan0 | grep wlan0 | awk '{print $6":"$8}' # too much awk

# grab which interface is UP from $(ip a)
intf="$(ip a | \
    grep -E 'enp0s|wlan0' | \
    grep " UP " | \
    cut -d ' ' -f 2 )"

if [ "$intf" = "wlan0:" ]; then
    med="wlan0"
elif [ "$intf" = "enp0s31f6:" ]; then
    med="enp0s31f6"
else
    printf "%s\n" "not connected"
    exit 1
fi

# grab stats from ifstat for active interface
if [ "$med" = "wlan0" ]; then
    wrx="$(ifstat wlan0 | \
        grep wlan0 | \
        tr -s '[:blank:]' | \
        cut -d ' ' -f 6)"
    wtx="$(ifstat wlan0 | \
        grep wlan0 | \
        sed 's@\ \ *@\ @g' | \
        cut -d ' ' -f 8)"
    printf "%s" "🛜$wrx🔽$wtx🔼"
else
    erx="$(ifstat enp0s31f6 | \
        grep enp0s31f6 | \
        tr -s '[:blank:]' | \
        cut -d ' ' -f 6)"
    etx="$(ifstat enp0s31f6 | \
        grep enp0s31f6 | \
        tr -s '[:blank:]' | \
        cut -d ' ' -f 8)"
    printf "%s" "🔳$erx🔽$etx🔼"
fi
