#!/bin/sh
#micvol
# get speaker and mic volume status

speakermute="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d ' ' -f 3)"
speakervol="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d ' ' -f 2)"
microphonemute="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | cut -d ' ' -f 3)"
microphonevol="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | cut -d ' ' -f 2)"

if [ -n "$speakermute" ]; then
    spk="🔇";
else
    spk="🎧$(printf "%s\n" "$speakervol*100/1" | bc)";
fi

if [ -n "$microphonemute" ]; then
    mic="🔇";
else
    mic="🎤$(printf "%s\n" "$microphonevol*100/1" | bc)";
    # the (/1) is required to prevent bc from outputting decimal
fi

printf "%s" "$spk:$mic"
