#!/bin/sh
#batt
# show battery status

# get charging/discharging status
if grep -iq discharging /sys/class/power_supply/BAT0/uevent; then
    stat="🪫";
elif grep -iq "not charging" /sys/class/power_supply/BAT0/uevent; then
    stat="🔌";
else
    stat="🔋";
fi

# get present battery capacity
cap=$(grep -i "capacity=" /sys/class/power_supply/BAT0/uevent | \
    sed 's@^.*\=@@')

# formatted output with alerts
if grep -iq discharging /sys/class/power_supply/BAT0/uevent && [ "$cap" -le 30 ]; then
    notify-send -u critical "Battery low" "Please plug-in charger"
    printf "%s" "❗$cap"
# not needed after setting, charge_stop_threshold in BAT0
# elif grep -iwq charging /sys/class/power_supply/BAT0/uevent && [ "$cap" -ge 80 ]; then
#     notify-send -u critical "Battery full" "Please turn off charging"
#     printf "%s" "❗$cap"
else printf "%s" "$stat$cap";
fi
