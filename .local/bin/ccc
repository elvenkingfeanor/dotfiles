# instead of starting the if-else statement with checking clipboard for URL, start with checking file for URL

if ! find . -maxdepth 1 -mindepth 1 -type f -name '*url' | xargs grep -Eiq 'http[s]://[^ ]+'; then
    if [ -z "$(xclip -o)" ]; then
        printf "%s\n" "Error, neither URL link nor URL file found"
        exit 1
    elif printf "%s" "$(xclip -o)" | grep -Eiq 'http[s]://[^ ]+'; then
        notify-send -u low "valid URL link found"
        projdir="$(pwd | sed 's@.*/@@')"
        projurl="$(printf "%s" "$(xclip -o)" | \
            xargs basename | sed 's@\..*$@@')"
        exturl="$(printf "%s" "$(xclip -o)" | sed 's@.*\.@@')"
        if [ "$projdir" = "$projurl" ]; then
            if [ -z "$exturl" ]; then
                curl -O "$(printf "%s" "$(xclip -o)")"    
            else
                curl -o "$projdir.$exturl" "$(printf "%s" "$(xclip -o)")"
            fi
        elif
            printf "%s" "$(xclip -o)" | grep -q "$projdir"; then
            if [ -z "$exturl" ]; then
                curl -O "$(printf "%s" "$(xclip -o)")"    
            else
                curl -o "$projdir.$exturl" "$(printf "%s" "$(xclip -o)")"
            fi
        else
            printf "%s\n" "Error, URL and dirname donot match"
            exit 1
        fi
    else
        printf "%s\n" "Error, no valid URL found in file"
        exit 1
    fi
else 
    notify-send -u low "URL file found"
    projdir="$(pwd | sed 's@.*/@@')"
    exturl="$(find . -maxdepth 1 -mindepth 1 -type f -name '*url' | \
        xargs grep -Eio 'http[s]://[^ ]+' | \
        sed 's@.*\.@@')"
    if [ -z "$exturl" ]; then
        curl -O "$(cat "$(find . -maxdepth 1 -mindepth 1 -type f -name '*url')")"
    else
        curl -o "$projdir.$exturl" "$(cat "$(find . -maxdepth 1 -mindepth 1 -type f -name '*url')")"
    fi
fi
