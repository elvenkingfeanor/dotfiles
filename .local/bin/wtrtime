#!/bin/sh
#wtrtime
# show daily sunrise, sunset, moonrise and moonset times

wfile="$HOME/.local/share/weather.txt"

# exit if wfile not present or empty
if [ -z "$wfile" ]; then
    exit 1
fi

# check if wfile updated for the day, then proceed accordingly
if [ "$(stat -c %y "$wfile" | cut -d ' ' -f1)" = "$(date '+%Y-%m-%d')" ]; then
    sunrise="$(jq -r '.weather[0].astronomy[0].sunrise' "$wfile")"
    sunset="$(jq -r '.weather[0].astronomy[0].sunset' "$wfile")"
    moonrise="$(jq -r '.weather[0].astronomy[0].moonrise' "$wfile")"
    moonset="$(jq -r '.weather[0].astronomy[0].moonset' "$wfile")"
    moonphase="$(jq -r '.weather[0].astronomy[0].moon_phase' "$wfile")"
else
    sunrise="$(jq -r '.weather[1].astronomy[0].sunrise' "$wfile")"
    sunset="$(jq -r '.weather[1].astronomy[0].sunset' "$wfile")"
    moonrise="$(jq -r '.weather[1].astronomy[0].moonrise' "$wfile")"
    moonset="$(jq -r '.weather[1].astronomy[0].moonset' "$wfile")"
    moonphase="$(jq -r '.weather[1].astronomy[0].moon_phase' "$wfile")"
fi

printf "%s\n" "Sunrise today at $sunrise. Sunset at $sunset. Moon to rise at $moonrise and set at $moonset. Moon is at $moonphase phase."
