#!/bin/sh
#packagelist
# return list of explicitly installed packages and groups associated with user
# for weekly cron

# user groups
id 1000 > ~/.bak/userinfo/groups.txt
# official (native) packages
pacman -Qqent > ~/.bak/userinfo/pacman.lst
# AUR (foreign) packages
pacman -Qqemt > ~/.bak/userinfo/aur.lst
# package check
pacman -Qk > ~/.bak/userinfo/package-check.txt

notify-send "package list generated"
