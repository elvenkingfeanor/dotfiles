#!/bin/sh
#clearcache
# periodically clean logfiles
# for monthly cron

# list of all logfiles in ~/.local/share/ directory
logfiles="$(find "$HOME/.local/share" \
    -maxdepth 1 \
    -type f \
    -name "*.log")"

# cat /dev/null to each entry in logfiles
for file in $logfiles;
do
    cat /dev/null > "$file"
done
