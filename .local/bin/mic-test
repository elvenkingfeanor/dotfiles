#!/bin/sh
#mic-test
# test microphone quality
micmute="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | cut -d ' ' -f 3)"

if [ -n "$micmute" ]; then
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
    notify-send "Start speaking" "3 seconds"
    arecord --duration=3 --format=dat ~/test-mic.wav
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1
else
    notify-send "Start speaking" "3 seconds"
    arecord --duration=3 --format=dat ~/test-mic.wav
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1
fi

sleep 1;
aplay ~/test-mic.wav
