#!/bin/sh
#lsext
# list extensions of all files in a directory

input="$*"

# check if directory exists and is not empty, else exit
if [ -z "$input" ]; then
    printf "%s\n" "$input directory does not exists"
    exit 1
elif
    [ -d "$input" ]; then
    if [ -z "$(find "$input" -mindepth 1)" ]; then
        printf "%s\n" "$input directory is empty"
        exit 1
    else
        # find "$input" -type f | perl -ne 'print $1 if m/\.([^.\/]+)$/' | sort -u
        find "$input" -type f -iname '*.?*' | \
            rev | \
            cut -d. -f1 | \
            rev | \
            sort | \
            uniq -c | \
            sort -rn
    fi
fi
