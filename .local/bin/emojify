#!/bin/sh
#emojify
# select emoji from emoji file to clipboard

# path to emoji file
file="$HOME/.local/share/emoji.txt"

# check whether dmenu is present, if not check for fzf, else exit
if ! command -v dmenu > /dev/null 2>&1; then
	if command -v fzf > /dev/null 2>&1; then
	chooser="fzf"
	else
        printf "%s\n" "Install dmenu or fzf to proceed"
		exit 1
	fi
else
	chooser="dmenu"
fi

# use dmenu or fzf to pick emoji
if [ -z "$file" ]; then
    printf "%s\n" "No emoji file present. Exiting.."
    exit 1
else
    if [ "$chooser" = "dmenu" ]; then
        cat "$file" | \
            "$chooser" -p "pick an emoji" | \
            cut -d ' ' -f 1 | \
            tr -d '\n' | \
            xclip -selection clipboard
    else
        cat "$file" | \
            "$chooser" --prompt="pick an emoji" | \
            cut -d ' ' -f 1 | \
            tr -d '\n' | \
            xclip -selection clipboard
    fi
fi
