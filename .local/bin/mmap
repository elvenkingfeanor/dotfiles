#!/bin/sh
#mmap
# create maps of minetest worlds
# check for world directories, and select one using fzf

selected=$(find "$XDG_DATA_HOME"/luanti/worlds -mindepth 1 -type d | fzf) # exclude root directory from printing

# error handling
if [ -z "$selected" ]; then
       echo "No worlds selected"
       exit 1
       else
           shortsel=$(echo "$selected" | sed 's@.*worlds/@@') # grab world name
           seedsel=$(grep -rI "^seed" "$selected" | cut -d " " -f 3) # grab world seed ID
           if grep -Eq "^..v7" "$selected"/map_meta.txt; then
                  mapgen="v7"
           elif grep -Eq "^..v6" "$selected"/map_meta.txt && grep -q noflat "$selected"/map_meta.txt; then
                  mapgen="v6"
           else mapgen="v6-flat"
           fi
fi

# after selection, let minetestmapper generate the map to specified location

# minetestmapper --draworigin --drawplayers --backend "sqlite3" --zoom 4 -v -i "$selected" -o ~/mdi/pix/mmaps/"$shortsel"-"$seedsel"-"$(date +%Y%m%d%H%M%S)".png
# minetestmapper --draworigin --drawplayers --backend "sqlite3" --zoom 4 -v -i "$selected" -o ~/mdi/pix/mmaps/"$shortsel"-"$seedsel".png
minetestmapper --draworigin --drawplayers --backend "sqlite3" -v -i "$selected" -o ~/mdi/pix/mmaps/"$shortsel"-"$seedsel"-"$mapgen".png
