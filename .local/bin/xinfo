#!/bin/sh
#xinfo
# Export the dbus session address on startup so it can be used by cron
touch $XDG_CONFIG_HOME/X11/xdbus
chmod 600 $XDG_CONFIG_HOME/X11/xdbus
env | grep DBUS_SESSION_BUS_ADDRESS > $XDG_CONFIG_HOME/X11/xdbus
echo 'export DBUS_SESSION_BUS_ADDRESS' >> $XDG_CONFIG_HOME/X11/xdbus
# Export the Xauthority value on startup so it can be used by cron
env | grep XAUTHORITY >> $XDG_CONFIG_HOME/X11/xdbus
echo 'export XAUTHORITY' >> $XDG_CONFIG_HOME/X11/xdbus
