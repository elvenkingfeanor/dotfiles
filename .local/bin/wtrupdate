#!/bin/sh
#wtrupdate
# get daily weather report from wttr.in
# for use with daily cron

wfile="$HOME/.local/share/weather.txt"
wttrlog="$HOME/.local/share/wttr.log"

# create logfile, if not present
if [ -z "$wttrlog" ]; then touch "$wttrlog"; fi

# check modification time of wfile, and update once daily, notifying once
# shellcheck disable=2154
if [ -s "$wfile" ]; then
    if [ "$(jq -r '.weather[0].date' "$wfile" | tr -d '-')" -ne "$(date '+%Y%m%d')" ]; then
        if ! curl -sf wttr.in/"$place"\?format=j1 > "$wfile" 2>>"$wttrlog"; then
            notify-send "weather update failed for today $(date '+%Y-%m-%d')"
            exit 1
        else
            notify-send "weather report updated for today $(date '+%Y-%m-%d')"
        fi
    else
        notify-send "weather report up-to-date for today $(date '+%Y-%m-%d')"
    fi
elif [ -f "$wfile" ]; then
    if ! curl -sf wttr.in/"$place"\?format=j1 > "$wfile" 2>>"$wttrlog"; then
        notify-send "weather update failed for today $(date '+%Y-%m-%d')"
        exit 1
    else
        notify-send "weather report updated for today $(date '+%Y-%m-%d')"
    fi
elif [ -z "$wfile" ]; then
    touch "$wfile"
    if ! curl -sf wttr.in/"$place"\?format=j1 > "$wfile" 2>>"$wttrlog"; then
        notify-send "weather update failed for today $(date '+%Y-%m-%d')"
        exit 1
    else
        notify-send "weather report updated for today $(date '+%Y-%m-%d')"
    fi
elif ! ping -c2 wttr.in > /dev/null 2>>"$wttrlog"; then
    notify-send "wttr.in maybe down, try again later"
    exit 1
else
    notify-send "no weather report generated, check logfile"
    exit 1
fi
