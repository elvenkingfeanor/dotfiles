#!/bin/sh
#mailupdate
# update maildir and mu index
# to be used by hourly cron

maildir="$HOME/.local/share/maildir/"

# update maildir and index mu first
mbsync -c "$HOME/.config/isync/mbsyncrc" -aq

sleep 5

mu index -q

# check for new mail and count 'em
mail="$(find $maildir/*/Inbox -path '*/new/*' -type f -print | wc -l)"

# only send notifications, when there's new mail
if [ "$mail" -ne 0 ]; then
    notify-send "You have $mail new mail"
fi
