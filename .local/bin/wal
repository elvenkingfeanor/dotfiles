#!/bin/sh
#wal
# select image for setting as wallpaper
# selected image copied to xwallpaper config directory
# old script, rarely used, updated

selected="$( find . \
    -type f \( \
    -iname "*.jpg" -o \
    -iname "*.jpeg" -o \
    -iname "*.png" -o \
    -iname "*.webp" -o \
    -iname "*.tiff" -o \
    -iname "*.bmp" \
    \) -print | \
    sort -u | \
    xargs nsxiv -iftoq | \
    sed 's@^\.@'"$PWD"'@')"

# set wallpaper
if [ -z "$selected" ]; then
    notify-send "Exiting..." "No image selected"
    exit 1
else
    xwallpaper --focus "$selected"
    notify-send "Setting wallpaper" "Wallpaper set from $selected"
    # copy image and image info to xwallpaper config directory
    echo "xwallpaper --focus $selected" > "$XDG_CONFIG_HOME"/xwallpaper/swall
    ~/.local/bin/cpr "$selected" "$XDG_CONFIG_HOME"/xwallpaper/output.jpg
fi
