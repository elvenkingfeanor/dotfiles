#!/bin/sh
#bright
# automatically sets brightness depending on time of day, else set it as desired
# send requisite signal to statusbar

time="$(date +%H%M)"
lvl="$1"

if [ -n "$lvl" ]; then
	light -S "$lvl"
	notify-send --urgency=low "Brightness set to $lvl"
	pkill -RTMIN+12 dwmblocks
elif [ "$time" -ge 600 ] && [ "$time" -lt 1600 ]; then
	light -S 100
	notify-send --urgency=low "Brightness set to 100"
	pkill -RTMIN+12 dwmblocks
elif [ "$time" -ge 1600 ] && [ "$time" -lt 1615 ]; then
	light -S 90
	notify-send --urgency=low "Brightness set to 90"
	pkill -RTMIN+12 dwmblocks
elif [ "$time" -ge 1615 ] && [ "$time" -lt 1630 ]; then
	light -S 80
	notify-send --urgency=low "Brightness set to 80"
	pkill -RTMIN+12 dwmblocks
elif [ "$time" -ge 1630 ] && [ "$time" -lt 1645 ]; then
	light -S 75
	notify-send --urgency=low "Brightness set to 75"
	pkill -RTMIN+12 dwmblocks
else [ "$time" -ge 1645 ] || [ "$time" -lt 600 ];
	light -S 70
	notify-send --urgency=low "Brightness set to 70"
	pkill -RTMIN+12 dwmblocks
fi
