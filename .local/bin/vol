#!/bin/sh
#vol
# set speaker volume
# send requisite signal to statusbar
# max speaker volume set to 80% (my laptop speakers are starting to sound a bit tin-ny)

lvl="$1"
# lvl has to be an integer, with value range from 0 to 80
if [ -n "$lvl" ] && ! [ "$lvl" -eq "$lvl" ]; then
    notify-send "has to be an integer" "accepted range from 0 to 80"
    exit 1
elif [ "$lvl" -lt 0 ] || [ "$lvl" -gt 80 ]; then
    notify-send "accepted range from 0 to 80"
    exit 1
fi

mute="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -ioq muted)"

if [ -n "$mute" ]; then
    if [ -n "$lvl" ]; then
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
        wpctl set-volume -l 0.8 @DEFAULT_AUDIO_SINK@ "$lvl"%
        pkill -RTMIN+11 dwmblocks
        notify-send "Audio volume" "set to $lvl"
    else
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        pkill -RTMIN+11 dwmblocks
        notify-send "Audio volume" "set to $lvl"
    fi
else
    if [ -n "$lvl" ]; then
        wpctl set-volume -l 0.8 @DEFAULT_AUDIO_SINK@ "$lvl"%
        pkill -RTMIN+11 dwmblocks
        notify-send "Audio volume" "set to $lvl"
    else
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        pkill -RTMIN+11 dwmblocks
        notify-send "Audio muted"
    fi
fi
