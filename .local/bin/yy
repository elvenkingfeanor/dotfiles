#!/bin/sh
#yy
# yank file path in current directory to clipboard
# can be multiple files, select by TAB
# to simply select single file, just press RETURN
# final list is space-separated

# check if fzf is installed first, else abort with message
if ! command -v fzf > /dev/null 2>&1; then
    notify-send "Aborted!" "Install fzf to continue"
    exit 1
fi

selected="$(find . -type f | \
    sort -u | \
    fzf -m | \
    sed 's@^\.@'"$PWD"'@g' | \
    paste -s -d ' ' | \
    tr -d '\n')"

if [ -z "$selected" ]; then
    notify-send "Aborted!" "No file selected"
    exit 1
else
    printf "%s" "$selected" | xclip -selection clipboard
    notify-send "Success!" "$selected copied to clipboard"
fi
