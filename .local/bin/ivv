#!/bin/sh
#ivv
# open all image files, without caching, in directory with nsxiv
# display selected images absolute paths to stdout

find . -mindepth 1 \
    -type f \( \
    -iname "*.jpg" -o \
    -iname "*.jpeg" -o \
    -iname "*.png" -o \
    -iname "*.gif" -o \
    -iname "*.tiff" -o \
    -iname "*.bmp" -o \
    -iname "*.webp" \
    \) -print | \
    sort -t '.' -k 3,3 -n | \
    nsxiv -itpoq | \
    sed 's@^\.@'"$PWD"'@' | \
    paste -s -d ' ' | \
    tr -d '\n'
