#!/bin/sh
#iv
# view all images in directory &&
# yank selected images paths to system clipboard

find . -maxdepth 1 \
    -type f \( \
    -iname "*.jpg" -o \
    -iname "*.jpeg" -o \
    -iname "*.png" -o \
    -iname "*.webp" -o \
    -iname "*.gif" -o \
    -iname "*.tiff" -o \
    -iname "*.bmp" \
    \) -print | \
    sort -u | \
    xargs nsxiv -iftoq | \
    sed 's@^\.@'"$PWD"'@' | \
    paste -s -d ' ' | \
    tr -d '\n' | \
    xclip -selection clipboard
