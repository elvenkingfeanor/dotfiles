#!/bin/sh
#mic
# set microphone audio
# send requisite signal to statusbar
# max mic audio set to 120%

lvl="$1"
# lvl has to be an integer, with value range from 0 to 120
if [ -n "$lvl" ] && ! [ "$lvl" -eq "$lvl" ]; then
    notify-send "has to be an integer" "accepted range from 0 to 120"
    exit 1
elif [ "$lvl" -lt 0 ] || [ "$lvl" -gt 120 ]; then
    notify-send "accepted range from 0 to 120"
    exit 1
fi

mute="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -ioq muted)"

if [ -n "$mute" ]; then
    if [ -n "$lvl" ]; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
        wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SOURCE@ "$lvl"%
        pkill -RTMIN+11 dwmblocks
        notify-send "Mic volume" "set to $lvl"
    else
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        pkill -RTMIN+11 dwmblocks
        notify-send "Mic volume" "set to $lvl"
    fi
else
    if [ -n "$lvl" ]; then
        wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SOURCE@ "$lvl"%
        pkill -RTMIN+11 dwmblocks
        notify-send "Mic volume" "set to $lvl"
    else
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        pkill -RTMIN+11 dwmblocks
        notify-send "Mic muted"
    fi
fi
