#!/bin/sh
#gitraw
# convert GitHub html links to raw links for curl
# only works with xclip primary selection

# check if clipboard is empty, else continue
# check clipboard for Github html link
# convert and put back into clipboard for further use
if [ -z "$(xclip -o)" ]; then
    printf "%s\n" "Nothing in clipboard"
    exit 1
else
    if printf "%s" "$(xclip -o)" | grep -qE 'github\.com'; then
        if printf "%s" "$(xclip -o)" | grep -qE 'blob/'; then
            printf "%s" "$(xclip -o)" | \
                sed 's@blob@refs/heads@;s@github\.com@raw\.githubusercontent\.com@' | \
                xclip -i
        else
            printf "%s" "$(xclip -o)" | \
                sed 's@raw/@@;s@github.com@raw.githubusercontent.com@' | \
                xclip -i
        fi
    fi
fi

# analyse raw URL name before saving:
# if name is 'README.org', then save link as readme.url,
# where, *project* is basename of directory
# else, save as 'url'
if printf "%s" "$(xclip -o)" | grep -Eiq "readme\.org"; then
    xclip -o > readme.url
else
    xclip -o > url
fi
