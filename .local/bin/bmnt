#!/bin/sh
#bmnt
# mount removable backup drive and cd into it

# let's make it more extensible for future more backup drives
# future backup drives nomenclature (LABEL) = backup-{1..n}

# logfile
logfile="$HOME/.local/share/bmnt.log"

# list of backup drives attached
bdrive="$(lsblk -anlp -o +LABEL | \
	grep backup | \
	cut -d ' ' -f 1)"

# exit if no backup drive attached
if [ -z "$bdrive" ]; then
	notify-send "No backup drive attached" "Nothing to mount"
	exit 1
fi

# if number of attached backup drives -eq 1, then bypass chooser application
if [ "$(printf "%s\n" "$bdrive" | \
	wc -l)" -eq 1 ]; then
	selected="$bdrive"
else
	if ! command -v dmenu > /dev/null 2>&1; then
		if command -v fzf > /dev/null 2>&1; then
			selected="$(printf "%s\n" "$bdrive" | \
				fzf --prompt="choose backup drive to mount: ")"
		else
			notify-send "Error" "Install dmenu or fzf to proceed"
			exit 1
		fi
	else
		selected="$(printf "%s\n" "$bdrive" | \
			dmenu -p "choose backup drive to mount: ")"
	fi
fi

# mount selected backup drive as per its label
# LABEL is last word of lsblk output line
# space-separated drive LABEL, maynot work
blbl="$(lsblk -anlp -o +LABEL | \
	grep "$selected" | \
	sed 's@^.*\ @@g')"

# check if backup drive is mounted, else proceed accordingly
if [ -n "$(findmnt "$selected")" ]; then
	notify-send "Backup drive $selected" "already mounted"
    cd /media/"$blbl" || exit
else
	if ! pmount "$selected" "$blbl" 2>>"$logfile"; then
		notify-send "Backup drive $selected" "couldnot be mounted"
		exit 1
	else
		notify-send "Backup drive $selected" "mounted successfully at /media/$blbl"
        pkill -RTMIN+14 -f dwmblocks
        cd /media/"$blbl" || exit
	fi
fi

$SHELL
