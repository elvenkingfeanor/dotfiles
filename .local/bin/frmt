#!/bin/sh
#frmt
# format partitions
# renamed from fmt to frmt to resolve naming conflict with fmt package in 

# check whether dmenu is present, if not check for fzf, else exit
if ! command -v dmenu > /dev/null 2>&1; then
	if command -v fzf > /dev/null 2>&1; then
	chooser="fzf"
	else
		notify-send "Error" "Install dmenu or fzf to proceed"
		exit 1
	fi
else
	chooser="dmenu"
fi

# choose partition to format, abort if none selected
# added additional grep to prevent accidental erasures
if [ "$chooser" = "dmenu" ]; then
	part="$(lsblk -anlp -o +LABEL | \
		grep -vE "nvme|backup" | \
		grep part | \
		cut -d ' ' -f 1 | \
		dmenu -p "select partition to format: ")"
else
	part="$(lsblk -anlp -o +LABEL | \
		grep -vE "nvme|backup" | \
		grep part | \
		cut -d ' ' -f 1 | \
		fzf --prompt="select partition to format: ")"
fi

# abort if no partition selected
if [ -z "$part" ] ; then
	notify-send "Stopping..." "No valid partition selected."
	exit 1
fi

# if partition is mounted, warn, then proceed accordingly
if [ -n "$(findmnt "$part")" ]; then
	if [ "$chooser" = "dmenu" ]; then
		affirm="$(printf "%b" "yes\nno" | \
			dmenu -p "proceed to unmount and format?")"
	else
		affirm="$(printf "%b" "yes\nno" | \
			fzf --prompt="proceed to unmount and format?")"
	fi
else
	if [ "$chooser" = "dmenu" ]; then
		affirm="$(printf "%b" "yes\nno" | \
			dmenu -p "proceed to format?")"
	else
		affirm="$(printf "%b" "yes\nno" | \
			fzf --prompt="proceed to format?")"
	fi
fi

# if choice is negative, abort
if [ "$affirm" = "no" ]; then
	notify-send "Stopping..." "Chose to stop."
	exit 1
fi

# choose filesystem type to format to
if [ "$chooser" = "dmenu" ]; then
	fstype="$(printf "%b" "ext4\nfat32" | \
		dmenu -p "choose filesystem type to format to: ")"
else
	fstype="$(printf "%b" "ext4\nfat32" | \
		fzf --prompt="choose filesystem type to format to: ")"
fi

# give a suitable label to partition
if [ "$chooser" = "dmenu" ]; then
	label="$(dmenu -p "give a label to partition: " < /dev/null)"
else
    # label="$(fzf --prompt="give a label to partition: " --print-query)" # meaningless fuzzy searching of $HOME
	printf "%s" "give a new label to partition: " && read -r label
fi

# give a final warning
if [ "$chooser" = "dmenu" ]; then
	choice="$(printf "%b" "yes\nno" | \
		dmenu -p "all data will be erased. really want to proceed?: ")"
else
	choice="$(printf "%b" "yes\nno" | \
		fzf --prompt="all data will be erased. really want to proceed?: ")"
fi

if [ "$choice" = "no" ]; then
	notify-send "Stopping..." "Chose to stop formatting"
	exit 1
fi

# proceed with format
if [ "$affirm" = "yes" ] && [ -n "$(findmnt "$part")" ]; then
	if [ -n "$label" ]; then
		if [ "$fstype" = "ext4" ]; then
			pumount "$part"
			if ! doas mkfs.ext4 "$part" -L "$label"; then
				printf "%s\n" "Aborted"
				exit 1
			fi
		else
			pumount "$part"
			if ! doas mkfs.vfat -F 32 "$part" -n "$label"; then
				printf "%s\n" "Aborted"
				exit 1
			fi
		fi
	else
		if [ "$fstype" = "ext4" ]; then
			pumount "$part"
			if ! doas mkfs.ext4 "$part"; then
				printf "%s\n" "Aborted"
				exit 1
			fi
		else
			pumount "$part"
			if ! doas mkfs.vfat -F 32 "$part"; then
				printf "%s\n" "Aborted"
				exit 1
			fi
		fi
	fi
else
	if [ -n "$label" ]; then
		if [ "$fstype" = "ext4" ]; then
			if ! doas mkfs.ext4 "$part" -L "$label"; then
				printf "%s\n" "Aborted"
				exit 1
			fi
		else
			if ! doas mkfs.vfat -F 32 "$part" -n "$label"; then
				printf "%s\n" "Aborted"
				exit 1
			fi
		fi
	else
		if [ "$fstype" = "ext4" ]; then
			if ! doas mkfs.ext4 "$part"; then
				printf "%s\n" "Aborted"
				exit 1
			fi
		else
			if ! doas mkfs.vfat -F 32 "$part"; then
				printf "%s\n" "Aborted"
				exit 1
			fi
		fi
	fi
fi
